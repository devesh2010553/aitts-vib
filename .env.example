# ── Required ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/aiits
ADMIN_EMAIL=your_admin@gmail.com
ADMIN_PASSWORD=your_secure_admin_password_here
JWT_SECRET=paste_a_very_long_random_string_here_at_least_64_characters_long

# ── Chat storage (optional — falls back to MONGODB_URI if unset) ────────────
# A second, separate MongoDB used only for chat messages so chat traffic
# doesn't eat into the main cluster's storage. Messages persist until an
# admin deletes them.
MONGODB_URI2=mongodb+srv://user:password@cluster2.mongodb.net/aiits-chat

# ── Firebase (replaces EMAIL_USER / EMAIL_PASS / OTP logic) ─────────────────
# STEPS:
# 1. Go to https://console.firebase.google.com → your project
# 2. Project settings → Service accounts → Generate new private key
# 3. Copy the ENTIRE JSON content and paste below (all on one line)
# 4. Also paste the firebaseConfig into frontend/index.html (search for YOUR_FIREBASE_API_KEY)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Google Sheets (unchanged) ────────────────────────────────────────────────
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ── Optional ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
CLIENT_URL=https://aiits.onrender.com

# ── Push Notifications (optional) ────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── AI PDF Test Import (optional — feature is disabled without XAI_API_KEY) ──
# Server-side only, never exposed to the frontend. Get a key from
# https://console.x.ai (note: billed per-token like any AI API — xAI's
# Playground is free to try in-browser, but the API itself is not free).
# Without this set, uploads to /api/admin/ai/import-pdf return a 503 rather
# than failing unpredictably.
XAI_API_KEY=
# Optional overrides (sane defaults if omitted) — verify AI_IMPORT_MODEL is
# still a current vision-capable model at console.x.ai before deploying,
# model names/pricing change over time:
AI_IMPORT_MODEL=grok-4-fast
AI_IMPORT_PAGES_PER_BATCH=2

# REMOVED (no longer needed — Firebase handles email):
# EMAIL_USER
# EMAIL_PASS
# OTP_EXPIRY

# ── Firebase Frontend Config (public keys — safe to expose, injected by server) ──
# Get from: Firebase Console → Project settings → Your apps → Web app
FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXX
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
